#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.

# 一次性启动标记: Windows 端 to-ubuntu.ps1 会在 EFI 分区根目录写入
# bootubuntu.once。检测到则本次直接启动 Ubuntu(无菜单等待)。
# 标记由 Ubuntu 开机后的 bootflag-clean systemd 服务负责删除, GRUB 只读不删。
search --fs-uuid --set=esp 76AB-E0F5
if [ -f (${esp})/bootubuntu.once ]; then
    set default=0
    set timeout=0
fi
